# Copy to .env and adjust. Never commit the real .env file.

# --- Docker Compose -------------------------------------------------------
POSTGRES_USER=returndesk
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=returndesk
# Host ports (container ports are fixed)
DB_PORT=5433
WEB_PORT=8080

# --- Backend (FastAPI) ----------------------------------------------------
# development | test | production
ENVIRONMENT=development
# Used when running the API outside Docker. Inside Compose this is built from the values above.
DATABASE_URL=postgresql+psycopg://returndesk:change-me-locally@localhost:5433/returndesk
# Browser origins allowed to call the API with cookies (comma separated).
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Set to true whenever the site is served over HTTPS.
COOKIE_SECURE=false
# lax works when the frontend and API share a site (the default setup). Use "none" (with
# COOKIE_SECURE=true) only if the frontend and API live on different sites.
COOKIE_SAMESITE=lax
SESSION_DAYS=7
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Load the fictional demo accounts on startup (Docker only). Use false for a real deployment.
SEED_DEMO_DATA=true

# --- Frontend (Vite) ------------------------------------------------------
# Only needed if the API is on a different origin than the frontend.
# VITE_API_URL=https://api.example.com
# Hide the demo account shortcuts on the login page.
# VITE_SHOW_DEMO_ACCOUNTS=false
